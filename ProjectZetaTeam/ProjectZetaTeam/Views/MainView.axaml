<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ProjectZetaTeam.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="550"
             x:Class="ProjectZetaTeam.Views.MainView"
             x:DataType="vm:MainViewModel">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
        to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <!-- container -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Border Background="Transparent"
                DragDrop.AllowDrop="True"
                DragDrop.Drop="OnVisualElementDrop"
                DragDrop.DragOver="OnVisualElementDragOver"
                Padding="20">

            <!--
            Row 0 (auto): title
            Row 1 (auto): file
            Row 2 (auto):    text
            -->
            <Grid RowDefinitions="auto, auto, auto" Classes="mainContainer">

                <!-- ================================== -->
                <Border Classes="header" Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,15">
                    <StackPanel Classes="title" Orientation="Horizontal">
                        <TextBlock FontSize="35">ZETA/</TextBlock>
                        <TextBlock Foreground="Red" FontSize="35">/TEAM</TextBlock>
                        <TextBlock Text="жоске вайбкодинг" VerticalAlignment="Bottom" Margin="10,0,0,5"/>
                    </StackPanel>
                </Border>

                <!-- ================================== -->

                <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,0,0,25">

                    <!-- theme + language -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <Button Name="ThemeToggleButton"
                                Content="Сменить тему"
                                Click="ThemeToggleButton_OnClick"
                                Padding="15,8"/>
                        <Button Name="LangToggleButton"
                                Content="RU / EN / 中"
                                Click="LangToggleButton_OnClick"
                                Padding="15,8"
                                Margin="10,0,0,0"/>
                    </StackPanel>

                    <!-- choose file -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBlock Name="LabelSelectFile" FontSize="18" Text="Выберите файл:" VerticalAlignment="Center"/>
                        <Button Name="SelectFile"
                                Content="Выбрать"
                                FontSize="14"
                                Margin="20,0,0,0"
                                Width="80"
                                Click="SelectFileButton_Click"/>
                    </StackPanel>

                    <!-- filepath -->
                    <TextBlock Name="SelectedFileText" Text="// Тут путь до выбранного файла" Opacity="0.5" Margin="0,0,0,5" TextWrapping="Wrap"/>
                    <TextBlock Name="MessageTextBlock" Text="// А тут выводятся сообщения" Opacity="0.5" Margin="0,0,0,15" TextWrapping="Wrap"/>

                    <!-- encrpt -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Name="LabelSelectMethod" Text="Выберите метод:" FontSize="18" VerticalAlignment="Center"/>
                        <ComboBox Name="MethodsSelect" FontSize="14" Margin="10,0,0,0" Width="80">
                            <ComboBoxItem Content="LSB"/>
                            <ComboBoxItem Content="EXIF"/>
                        </ComboBox>
                    </StackPanel>

                </StackPanel>

                <!-- ================================== -->
                <StackPanel Grid.Row="2" Orientation="Vertical">

                    <!-- preview img -->
                    <Border BorderBrush="Gray"
                            BorderThickness="1"
                            CornerRadius="4"
                            MaxHeight="600"
                            MinHeight="100"
                            Margin="0,0,0,15"
                            HorizontalAlignment="Stretch">
                        <Image x:Name="SelectedImage"
                               Stretch="Uniform"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>
                    </Border>

                    <!-- text -->
                    <TextBlock Name="LabelText" FontSize="20" Text="Текст:" Margin="0,0,0,5"/>
                    <TextBox Name="TextMessage"
                             MinHeight="50"
                             Watermark="Введите текст..."
                             Margin="0,0,0,15"/>

                    <!-- lowest buttons -->
                    <StackPanel Orientation="Horizontal">
                        <Button Name="Start" Content="Зашифровать" Click="OnEncryptAndSaveButtonClick"/>
                        <Button Name="StartDeEncrypt" Content="Расшифровать" Click="OnDecryptButtonClick" Margin="10,0,0,0"/>
                    </StackPanel>

                </StackPanel>

            </Grid>
        </Border>
    </ScrollViewer>
</UserControl>